%%{init: {'theme':'dark','flowchart': {'rankSpacing': 70, 'nodeSpacing': 30, 'curve': 'basis'}} }%%
flowchart LR

  %% col=0 row=0
  subgraph INPUT[👤 玩家輸入]
    KEYS([鍵盤<br/>WASD・1-4・I・空白鍵]):::input
    MOUSE([滑鼠<br/>瞄準・左鍵・右鍵]):::input
    UPLOAD([上傳黑底 4×4 翻頁圖]):::input
  end

  %% col=1 row=0
  subgraph UI[🖥️ 介面層]
    MODE[開場選單<br/>故事模式・自由試玩]:::ui
    LAB[拆解台<br/>貼圖路線・基礎／升級・語音]:::ui
    HUD[目標提示・首領血條<br/>技能列・地形連鎖跳字]:::ui
    DLGUI[對白框<br/>頭像・逐字・跳過]:::ui
    INV[行囊<br/>照形狀占格・7 裝備欄]:::ui
  end

  %% col=2 row=0
  subgraph STORY[📖 故事層]
    ACTS[/幕次狀態機<br/>對白→清怪→前往→點燃→解鎖/]:::pipeline
    TOWER[(四座燈塔<br/>焰・雷・星・血)]:::model
    BOSS[/首領 AI<br/>衝擊波・召喚・黑暗/]:::pipeline
    VOICE[瀏覽器內建語音<br/>三種音高]:::worker
  end

  %% col=3 row=0
  subgraph LOGIC[⚙️ 遊戲邏輯 logic dt]
    CAST[/施法系統<br/>解鎖・冷卻・手勢/]:::pipeline
    SPELLS[/四招法術<br/>依進度決定強度/]:::pipeline
    ENEMY[/怪物 AI<br/>追擊・推開・地形減速/]:::pipeline
    LOOT[/掉寶與數值/]:::pipeline
  end

  %% col=3 row=1
  subgraph TERRAIN[🪨 地形層 P2]
    REACT[/反應表<br/>火・雷・星墜・血 → 改地形/]:::pipeline
    GRID[(地形網格 88×88<br/>15 種地形)]:::model
    TKILL[/地形殺<br/>持續傷害・連鎖 ×N・多掉寶/]:::pipeline
    PROPS[可破壞物<br/>倒下壓怪・燒倒・撞斷・裂開]:::worker
    SEED[(固定種子世界<br/>墓碑 46・枯樹 12・石棺 6)]:::model
    CA[/自動演變 每 0.2 秒<br/>蔓延・流動・冷卻・連鎖爆炸/]:::pipeline
  end

  %% col=4 row=0
  subgraph VFX[🔥 特效三零件 visuals dt]
    ATLAS[(翻頁圖集 1024²<br/>4 張 × 16 格)]:::model
    SHADER[/著色器三模式/]:::pipeline
    PSYS[粒子系統<br/>方塊永遠面向鏡頭]:::worker
    LIGHTS[燈光池 10 盞<br/>＋燈塔 4 盞]:::worker
    GTEX[地面貼圖兩張<br/>地面色＋疊加發光]:::worker
  end

  %% col=5 row=0
  subgraph OUT[🖼️ 輸出]
    CANVAS[(WebGL 畫面<br/>Three.js r128)]:::output
    SND[(合成音效＋語音)]:::output
  end

  %% col=6 row=0
  subgraph VERIFY[✅ 驗收層]
    STATIC[靜態閘門<br/>大小・外連・編譯・隱私]:::safety
    UNIT[單元測試 52 項<br/>含每種地形反應]:::safety
    E2E[端對端 36 項<br/>真實鍵盤滑鼠事件]:::safety
    CHECKS[其他驗證 43 項<br/>效能・地形負載・洩漏・手機]:::safety
    MUT[突變測試<br/>埋 5 個缺陷必須變紅]:::safety
    CI[(GitHub Actions<br/>每次推送自動跑)]:::output
  end

  KEYS --> CAST
  MOUSE --> CAST
  UPLOAD --> ATLAS
  MODE --> ACTS
  LAB -. 切換路線 .-> SHADER
  ACTS --> DLGUI
  DLGUI --> VOICE
  ACTS --> TOWER
  TOWER -. 點亮解鎖 .-> CAST
  ACTS --> BOSS
  BOSS --> ENEMY
  CAST --> SPELLS
  SPELLS --> PSYS
  SPELLS --> LIGHTS
  SPELLS --> ENEMY
  SPELLS --> REACT
  REACT --> GRID
  CA --> GRID
  GRID --> TKILL
  TKILL --> ENEMY
  SEED --> PROPS
  PROPS -. 壓怪 .-> TKILL
  BOSS -. 衝擊波推倒 .-> PROPS
  GRID --> GTEX
  ENEMY --> LOOT
  LOOT --> INV
  INV -. 換裝改數值 .-> CAST
  TKILL -. 連鎖跳字 .-> HUD
  ATLAS --> SHADER
  SHADER --> PSYS
  PSYS --> CANVAS
  LIGHTS --> CANVAS
  GTEX --> CANVAS
  VOICE --> SND
  UNIT -. 驗 .-> TERRAIN
  E2E -. 驗 .-> UI
  CHECKS -. 驗 .-> OUT
  MUT -. 驗測試本身 .-> UNIT
  STATIC --> CI
  UNIT --> CI
  E2E --> CI
  CHECKS --> CI

